# -----------------------------------------------------------------------------
# ClinGraph local development environment
# Copy this file to .env and fill in the values marked CHANGE_ME.
# Never commit .env or paste real secrets into source control.
# -----------------------------------------------------------------------------

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Backend service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
AI_SERVICE_URL=http://localhost:8001
BACKEND_SHARED_SECRET=CHANGE_ME

# AI service
AI_HOST=0.0.0.0
AI_PORT=8001
GROQ_API_KEY=CHANGE_ME
GROQ_MODEL=llama-3.3-70b-versatile

# Local Hugging Face/Sentence Transformers embeddings.
# The public model is downloaded once and then runs locally; no API key is needed.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_LOCAL_FILES_ONLY=false
EMBEDDING_DIMENSION=384

# Pinecone vector database
PINECONE_API_KEY=CHANGE_ME
PINECONE_INDEX_NAME=clingraph-evidence
PINECONE_ENVIRONMENT=CHANGE_ME
PINECONE_NAMESPACE=clinical-evidence

# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Redis queues/cache
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_NAME=clingraph-ingestion
REDIS_CACHE_TTL_SECONDS=3600

# Evidence sources
# PubMed and ClinicalTrials.gov work without API keys for basic usage.
NCBI_API_KEY=
NCBI_EMAIL=
PUBMED_RETMAX=20
CLINICALTRIALS_PAGE_SIZE=20

# Optional request and retrieval settings
REQUEST_TIMEOUT_SECONDS=45
BM25_WEIGHT=0.5
DENSE_WEIGHT=0.5
RETRIEVAL_TOP_K=10
